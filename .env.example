# Copy to .env (or `export` these) and edit to point at your local copies.
# Relative defaults resolve from the current working directory; run scripts
# from the repo root, or set absolute paths here.

# BEHRT data: patient sequences, canonical labels, vocab maps, result .npz
export HIPFX_BEHRT_DIR=data/behrt

# XGBoost / NN baselines: one-hot feature matrices, trained models, result .npz
export HIPFX_BASELINES_DIR=data/baselines

# UChicago external cohort: outcome + FRAX CSV
export HIPFX_UCHICAGO_DIR=data/uchicago

# Pipeline outputs (predictions / figures / tables)
export HIPFX_RESULTS_DIR=results

# Proprietary MarketScan demographic databases (sex, birth year, enrollment
# visibility). Used only by the matched-cohort matching in src/robustness/.
export HIPFX_MARKETSCAN_DEMO_DIR=data/marketscan_demographics

# BEHRT model + dataset modules for sys.path imports.
# Defaults to the in-repo src/behrt; only override if you keep them elsewhere.
# export HIPFX_BEHRT_CODE=src/behrt
