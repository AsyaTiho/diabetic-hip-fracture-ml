# Primary reported model: age-blind BEHRT-LoRA on the full MarketScan cohort.
#
# Age is always blanked by finetune_behrt_lora.py (temporal-leakage correction);
# there is no age-using variant to reproduce. This arm derives the 80/10/10
# split (seed 35) and writes the test-enrolid sidecar that the landmark and
# matched arms reuse, so BEHRT_SPLIT_FILE is intentionally left unset here.
#
# Source with:  set -a; source configs/primary.env; set +a
# or drive it with: python src/behrt/run_pipeline.py --config configs/primary.env

export BEHRT_FINETUNE_DATA="${HIPFX_BEHRT_DIR:-data/behrt}/patient_sequences_finetune.pkl"
export BEHRT_OUTPUT_DIR="models/behrt/primary"
export BEHRT_FINETUNE_CKPT="models/behrt/primary/behrt_lora_best.pt"
