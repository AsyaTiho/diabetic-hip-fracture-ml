# Landmark sensitivity arm (Delta = 180 days).
#
# Sequences are cut at each patient's diabetes_day + 180 and in-window fractures
# are strict-filtered (see src/robustness/build_landmark_cohort.py), so record
# length no longer counts down to the outcome. BEHRT_SPLIT_FILE pins the fixed
# split built by src/robustness/build_landmark_split.py, which makes this arm's
# test set a strict subset of the primary test set (comparable patient-for-patient).
# Age is always blanked, as in every arm.
#
# Build inputs first:
#   python src/robustness/build_landmark_split.py  --delta 180
#   python src/robustness/build_landmark_cohort.py --delta 180
# Then: python src/behrt/run_pipeline.py --config configs/landmark_180.env --score

export BEHRT_FINETUNE_DATA="${HIPFX_BEHRT_DIR:-data/behrt}/patient_sequences_landmark_180.pkl"
export BEHRT_SPLIT_FILE="${HIPFX_BEHRT_DIR:-data/behrt}/split_landmark_180.npz"
export BEHRT_OUTPUT_DIR="models/behrt/landmark_180"
export BEHRT_FINETUNE_CKPT="models/behrt/landmark_180/behrt_lora_best.pt"
export BEHRT_PRED_OUT="${HIPFX_RESULTS_DIR:-results}/outputs/predictions/landmark_180_behrt.npz"
