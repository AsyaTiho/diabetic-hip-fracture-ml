# Matched-cohort arm: landmark Delta = 180 with demographically matched controls.
#
# For each fracture case, controls are kept that match exactly on sex and birth
# year and fall within 30 days of the case's total enrollment visibility (k = 5
# controls per case). This flattens age, sex, and enrollment length across the
# classes so they cannot act as shortcuts, isolating disease-trajectory signal.
# The split is inherited from the landmark Delta = 180 split, so the matched test
# set stays a strict subset of the original test set. Age is always blanked.
#
# Build inputs first (see src/robustness/README.md for the full order):
#   build_matched_table.py -> join_demographics.sh -> run_matching.py
#   -> build_matched_cohort.py --k 5
# Then: python src/behrt/run_pipeline.py --config configs/matched_180_k5.env --score

export BEHRT_FINETUNE_DATA="${HIPFX_BEHRT_DIR:-data/behrt}/matched_sequences_180_k5.pkl"
export BEHRT_SPLIT_FILE="${HIPFX_BEHRT_DIR:-data/behrt}/split_matched_180_k5.npz"
export BEHRT_OUTPUT_DIR="models/behrt/matched_180_k5"
export BEHRT_FINETUNE_CKPT="models/behrt/matched_180_k5/behrt_lora_best.pt"
export BEHRT_PRED_OUT="${HIPFX_RESULTS_DIR:-results}/outputs/predictions/matched_180_k5_behrt.npz"

# Age channel: NORMAL (kept). Inherited from the landmark design this arm is
# drawn from: the window is already fixed, so the age gap carries nothing.
# Matching on birth year addresses comparability, not the age leak.
export BEHRT_AGE_MODE=normal
